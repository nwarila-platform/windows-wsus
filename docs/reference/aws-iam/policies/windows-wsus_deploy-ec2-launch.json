{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunInstancesTypeLocked",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:<region>:*:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:InstanceType": [
            "t3.medium",
            "t3.large"
          ],
          "ec2:Tenancy": "default",
          "ec2:MetadataHttpTokens": "required",
          "aws:RequestTag/nwarila:management:repository-id": "<repository-id>"
        },
        "NumericLessThanEquals": {
          "ec2:MetadataHttpPutResponseHopLimit": "1"
        }
      }
    },
    {
      "Sid": "RunInstancesVolumeCapped",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:<region>:*:volume/*",
      "Condition": {
        "StringEquals": {
          "ec2:VolumeType": "gp3",
          "aws:RequestTag/nwarila:management:repository-id": "<repository-id>"
        },
        "Bool": {
          "ec2:Encrypted": "true"
        },
        "NumericLessThanEquals": {
          "ec2:VolumeSize": "64"
        },
        "NumericLessThanEqualsIfExists": {
          "ec2:VolumeIops": "3000",
          "ec2:VolumeThroughput": "125"
        }
      }
    },
    {
      "Sid": "RunInstancesEniInDeploySubnet",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:<region>:*:network-interface/*",
      "Condition": {
        "ArnLike": {
          "ec2:Vpc": "arn:aws:ec2:<region>:*:vpc/<vpc-id>",
          "ec2:Subnet": "arn:aws:ec2:<region>:*:subnet/<subnet-id>"
        }
      }
    },
    {
      "Sid": "RunInstancesInDeploySubnet",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:<region>:*:subnet/<subnet-id>",
      "Condition": {
        "ArnLike": {
          "ec2:Vpc": "arn:aws:ec2:<region>:*:vpc/<vpc-id>"
        }
      }
    },
    {
      "Sid": "RunInstancesWithOwnedSecurityGroups",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:<region>:*:security-group/*",
      "Condition": {
        "ArnLike": {
          "ec2:Vpc": "arn:aws:ec2:<region>:*:vpc/<vpc-id>"
        },
        "StringEquals": {
          "ec2:ResourceTag/nwarila:management:repository-id": "<repository-id>"
        }
      }
    },
    {
      "Sid": "RunInstancesImagesFromTrustedOwners",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:<region>::image/*",
      "Condition": {
        "StringEquals": {
          "ec2:Owner": [
            "amazon",
            "<account-id>"
          ]
        }
      }
    },
    {
      "Sid": "RunInstancesWithPinnedKeyPair",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:<region>:<account-id>:key-pair/<key-pair-name>"
    },
    {
      "Sid": "ImportEphemeralCiKeyPair",
      "Effect": "Allow",
      "Action": "ec2:ImportKeyPair",
      "Resource": "arn:aws:ec2:<region>:<account-id>:key-pair/<key-pair-name>",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "<region>",
          "aws:RequestTag/nwarila:management:repository-id": "<repository-id>"
        }
      }
    },
    {
      "Sid": "CreateDataVolumeCapped",
      "Effect": "Allow",
      "Action": "ec2:CreateVolume",
      "Resource": "arn:aws:ec2:<region>:*:volume/*",
      "Condition": {
        "StringEquals": {
          "ec2:VolumeType": "gp3",
          "aws:RequestTag/nwarila:management:repository-id": "<repository-id>"
        },
        "Bool": {
          "ec2:Encrypted": "true"
        },
        "NumericLessThanEquals": {
          "ec2:VolumeSize": "64"
        },
        "NumericLessThanEqualsIfExists": {
          "ec2:VolumeIops": "3000",
          "ec2:VolumeThroughput": "125"
        }
      }
    },
    {
      "Sid": "CreateEniWithRepoIdentity",
      "Effect": "Allow",
      "Action": "ec2:CreateNetworkInterface",
      "Resource": "arn:aws:ec2:<region>:*:network-interface/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "<region>",
          "aws:RequestTag/nwarila:management:repository-id": "<repository-id>"
        }
      }
    },
    {
      "Sid": "UseDeploySubnetForEniCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateNetworkInterface",
      "Resource": "arn:aws:ec2:<region>:*:subnet/<subnet-id>",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "<region>"
        },
        "ArnLike": {
          "ec2:Vpc": "arn:aws:ec2:<region>:*:vpc/<vpc-id>"
        }
      }
    },
    {
      "Sid": "UseOwnedSecurityGroupsForEniCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateNetworkInterface",
      "Resource": "arn:aws:ec2:<region>:*:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "<region>",
          "ec2:ResourceTag/nwarila:management:repository-id": "<repository-id>"
        },
        "ArnLike": {
          "ec2:Vpc": "arn:aws:ec2:<region>:*:vpc/<vpc-id>"
        }
      }
    },
    {
      "Sid": "AllocateTaggedElasticIp",
      "Effect": "Allow",
      "Action": "ec2:AllocateAddress",
      "Resource": "arn:aws:ec2:<region>:<account-id>:elastic-ip/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "<region>",
          "aws:RequestTag/nwarila:management:repository-id": "<repository-id>"
        }
      }
    }
  ]
}
