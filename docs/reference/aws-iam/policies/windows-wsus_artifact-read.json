{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyWindowsWsusTlsArtifacts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<artifact-bucket>/applications/windows-wsus/tls/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "<region>"
        }
      }
    }
  ]
}
