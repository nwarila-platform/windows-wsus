{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeVolumes",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVolumes",
        "ec2:DescribeVolumeAttribute"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CreateTaggedVolume",
      "Effect": "Allow",
      "Action": "ec2:CreateVolume",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Repository": "nwarila-platform/windows-wsus",
          "aws:RequestTag/RepositoryId": "1316209092",
          "aws:RequestTag/ManagedBy": "Terraform"
        },
        "Null": {
          "aws:RequestTag/CommitSha": "false",
          "aws:RequestTag/RunId": "false",
          "aws:RequestTag/Environment": "false"
        }
      }
    },
    {
      "Sid": "AttachDetachOwnedVolumeAndInstance",
      "Effect": "Allow",
      "Action": [
        "ec2:AttachVolume",
        "ec2:DetachVolume"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:<account-id>:volume/*",
        "arn:aws:ec2:us-east-1:<account-id>:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Repository": "nwarila-platform/windows-wsus",
          "ec2:ResourceTag/RepositoryId": "1316209092",
          "ec2:ResourceTag/ManagedBy": "Terraform"
        },
        "Null": {
          "ec2:ResourceTag/CommitSha": "false",
          "ec2:ResourceTag/RunId": "false",
          "ec2:ResourceTag/Environment": "false"
        }
      }
    },
    {
      "Sid": "DeleteOwnedVolume",
      "Effect": "Allow",
      "Action": "ec2:DeleteVolume",
      "Resource": "arn:aws:ec2:us-east-1:<account-id>:volume/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Repository": "nwarila-platform/windows-wsus",
          "ec2:ResourceTag/RepositoryId": "1316209092",
          "ec2:ResourceTag/ManagedBy": "Terraform"
        },
        "Null": {
          "ec2:ResourceTag/CommitSha": "false",
          "ec2:ResourceTag/RunId": "false",
          "ec2:ResourceTag/Environment": "false"
        }
      }
    }
  ]
}
