{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteOnlyTheStateFileAndItsLock",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::<account-id>-terraform/nwarila-platform/windows-wsus/aws-poc.tfstate",
        "arn:aws:s3:::<account-id>-terraform/nwarila-platform/windows-wsus/aws-poc.tfstate.tflock"
      ]
    },
    {
      "Sid": "ListOnlyThoseTwoKeys",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<account-id>-terraform",
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "nwarila-platform/windows-wsus/aws-poc.tfstate",
            "nwarila-platform/windows-wsus/aws-poc.tfstate.tflock"
          ]
        }
      }
    },
    {
      "Sid": "ReadOnlyThePinnedOpenVpnInstaller",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<account-id>-apprepo/OpenVPN.net/OpenVPN Community/*/OpenVPNnet_OpenVPN-Community_*_x64.msi",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<account-id>"
        }
      }
    },
    {
      "Sid": "ReadOnlyTheDomainJoinAndOpenVpnCredentials",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::<account-id>-ansible/host_roles/domain_member/svc-domainjoin-password.txt",
        "arn:aws:s3:::<account-id>-ansible/host_roles/remote_client/aws-ec2-test.ovpn"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<account-id>"
        }
      }
    },
    {
      "Sid": "ReadOnlyTheWsusTlsArtifacts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::<account-id>-ansible/applications/windows-wsus/tls/tcnaw-wsus01.tcn.trinitytechnicalservices.com.pfx",
        "arn:aws:s3:::<account-id>-ansible/applications/windows-wsus/tls/tcnaw-wsus01.tcn.trinitytechnicalservices.com.pfx.password"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<account-id>"
        }
      }
    }
  ]
}
