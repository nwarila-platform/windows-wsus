# Deny-all .gitignore strategy per org ADR-0003: everything is ignored, and every tracked
# path is allowlisted explicitly below. The leading `**` is the only wildcard permitted;
# each entry names one directory or one file, so nothing can enter the repository silently.
**

# Root
!/.editorconfig
!/.gitignore
!/.shellcheckrc
!/.yamllint.yml
!/LICENSE
!/README.md
!/SECURITY.md
!/quality-tools.env
!/requirements-quality.txt
!/requirements-quality.yml

# .github/
!/.github/
!/.github/workflows/
!/.github/CODEOWNERS
!/.github/ansible-framework-pin
!/.github/renovate.json5
!/.github/terraform-framework-pin
!/.github/workflows/aws-deploy.yml
!/.github/workflows/aws-reaper.yml
!/.github/workflows/iam-drift.yml
!/.github/workflows/pin-bump.yml
!/.github/workflows/quality.yml

