# =========================================================================================== #
# File: '.gitignore'
# --- [ Description ] ----------------------------------------------------------------------- #
#
# DEFAULT-DENY, EXPLICIT INCLUDES ONLY. Nothing in this working tree is tracked unless it is
# explicitly allowed below, by name — no wildcard allowances. Adding a new file therefore
# requires allowing it here first — that is deliberate: it makes publishing a file an
# explicit act rather than an accident.
#
# =========================================================================================== #

# Ignore everything ...
**

# --- [ directory spine ] ------------------------------------------------------------------- #
# Git does not descend into an excluded directory, so every directory on the path to an
# allowed file is re-included by name. This publishes no files by itself: files inside these
# directories stay ignored until named in a section below.
!/.github/
!/.github/workflows/
!/ansible/
!/ansible/applications/
!/ansible/applications/wsus/
!/ansible/applications/wsus/defaults/
!/ansible/applications/wsus/files/
!/ansible/applications/wsus/meta/
!/ansible/applications/wsus/tasks/
!/ansible/applications/wsus/vars/
!/ansible/inventory/
!/ansible/playbooks/
!/docs/
!/docs/decision-records/
!/docs/decision-records/org/
!/docs/decision-records/repo/
!/docs/decision-records/template/
!/docs/explanation/
!/docs/reference/
!/docs/reference/aws-iam/
!/docs/reference/aws-iam/policies/
!/docs/reference/aws-iam/roles/
!/scripts/
!/terraform/

# --- [ allowed: repository configuration ] ------------------------------------------------- #
!/.editorconfig
!/.gitignore
!/.yamllint.yml
!/requirements-quality.txt
!/requirements-quality.yml

# --- [ allowed: top-level documents ] ------------------------------------------------------ #
!/LICENSE
!/README.md
!/SECURITY.md

# --- [ allowed: GitHub configuration ] ----------------------------------------------------- #
!/.github/CODEOWNERS
!/.github/ansible-framework-pin
!/.github/terraform-framework-pin
!/.github/workflows/aws-deploy.yml
!/.github/workflows/powershell.yml

# --- [ allowed: the ansible tree ] --------------------------------------------------------- #
!/ansible/applications/wsus/defaults/main.yml
!/ansible/applications/wsus/files/Get-SqlDatabasePlacement.pester.ps1
!/ansible/applications/wsus/files/Get-SqlDatabasePlacement.ps1
!/ansible/applications/wsus/meta/main.yml
!/ansible/applications/wsus/tasks/clean_windows.yml
!/ansible/applications/wsus/tasks/main.yml
!/ansible/applications/wsus/tasks/present_windows.yml
!/ansible/applications/wsus/tasks/validate.yml
!/ansible/applications/wsus/vars/windows.yml
!/ansible/inventory/aws_ec2.yml
!/ansible/playbooks/wsus-aws.yml

# --- [ allowed: published documentation ] -------------------------------------------------- #
!/docs/README.md
!/docs/decision-records/README.md
!/docs/decision-records/org/0001-use-architecture-decision-records.md
!/docs/decision-records/org/0002-adopt-diataxis-documentation-framework.md
!/docs/decision-records/org/0003-use-deny-all-gitignore-strategy.md
!/docs/decision-records/org/0004-use-renovate-for-dependency-updates.md
!/docs/decision-records/org/0005-keep-github-control-planes-namespace-local.md
!/docs/decision-records/repo/.gitkeep
!/docs/decision-records/template/0001-pin-terraform-and-provider-versions-exactly.md
!/docs/decision-records/template/0002-mandate-s3-state-backend.md
!/docs/decision-records/template/0004-isolate-pull-request-target-triggers.md
!/docs/decision-records/template/0005-enforce-thin-runner-deployer-shape.md
!/docs/explanation/technical-debt.md
!/docs/explanation/wsus-role-migration-contract.md
!/docs/reference/ansible-style-guide.md
!/docs/reference/aws-iam/README.md
!/docs/reference/aws-iam/policies/nwarila-platform_windows-wsus_runner_ebs.json
!/docs/reference/aws-iam/policies/nwarila-platform_windows-wsus_runner_ec2.json
!/docs/reference/aws-iam/policies/nwarila-platform_windows-wsus_runner_eni.json
!/docs/reference/aws-iam/policies/nwarila-platform_windows-wsus_runner_iam.json
!/docs/reference/aws-iam/policies/nwarila-platform_windows-wsus_runner_kms.json
!/docs/reference/aws-iam/policies/nwarila-platform_windows-wsus_runner_s3.json
!/docs/reference/aws-iam/policies/nwarila-platform_windows-wsus_runner_sg.json
!/docs/reference/aws-iam/roles/nwarila-ec2-role.trust.json
!/docs/reference/aws-iam/roles/nwarila-platform_windows-wsus_admin.trust.json
!/docs/reference/aws-iam/roles/nwarila-platform_windows-wsus_runner.trust.json

# --- [ allowed: scripts ] ------------------------------------------------------------------ #
!/scripts/compose-and-run.sh

# --- [ allowed: terraform (data-only; resources live in the pinned framework) ] ------------ #
!/terraform/README.md
!/terraform/aws.tfvars

# --- [ never tracked, even by a future allowance ] ----------------------------------------- #
# Composition build tree (framework checkout + overlaid roles) and build worktrees.
/.compose/
/.worktrees/
